<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ekran_arka_plani"
    android:padding="16dp"
    android:id="@+id/main"
    tools:context=".MainActivity">


    <LinearLayout
        android:id="@+id/blok_resimler"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:background="@color/kart_arka_plani"
        android:padding="8dp"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/blok_kayit"
        app:layout_constraintVertical_chainStyle="spread">

        <ImageView
            android:id="@+id/resim_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/resim_1" />

        <ImageView
            android:id="@+id/resim_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/resim_2" />

        <ImageView
            android:id="@+id/resim_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/resim_3" />

        <ImageView
            android:id="@+id/resim_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/resim_4" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/blok_kayit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/kart_arka_plani"
        android:padding="16dp"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blok_resimler"
        app:layout_constraintBottom_toTopOf="@+id/blok_giris">

        <EditText
            android:id="@+id/ad_soyad_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ipucu_ad_soyad"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/eposta_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ipucu_eposta"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/yas_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ipucu_yas"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/kayit_ol_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/buton_kayit_ol"
            android:textColor="@color/beyaz"
            app:backgroundTint="@color/kayit_butonu_rengi" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/blok_giris"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/kart_arka_plani"
        android:padding="16dp"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blok_kayit"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/kullanici_adi_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ipucu_kullanici_adi"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/sifre_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ipucu_sifre"
            android:inputType="textPassword"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/giris_yap_button1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/buton_giris_yap"
            android:textColor="@color/beyaz"
            app:backgroundTint="@color/giris_butonu_rengi" />

        <TextView
            android:id="@+id/sifremi_unuttum_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/metin_sifremi_unuttum"
            android:textColor="@color/sifremi_unuttum_rengi"
            android:textStyle="bold" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>